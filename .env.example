# ============================================
# Bollywood Connect the Stars - Environment
# ============================================

# --- API Server ---
PORT=4000
DATABASE_URL="file:./packages/db/dev.db"

# Production API: CORS origins (comma-separated)
# Example: CORS_ORIGIN=https://bollywood-connect.vercel.app,https://bollywood-connect-git-main.vercel.app
CORS_ORIGIN=

# Auth
JWT_SECRET=change-this-to-a-random-32-character-string
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Production Frontend: point to your Render API URL
# Example: NEXT_PUBLIC_API_URL=https://bollywood-connect-api.onrender.com
